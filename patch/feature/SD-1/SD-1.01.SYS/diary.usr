
CREATE USER "DIARY" IDENTIFIED BY "&&DIARY_password"
  DEFAULT TABLESPACE "&&default_tablespace"
  TEMPORARY TABLESPACE "&&temp_tablespace"
  QUOTA UNLIMITED ON "&&default_tablespace";



  GRANT CREATE SESSION TO "DIARY";
  GRANT CREATE TABLE TO "DIARY";
  GRANT CREATE CLUSTER TO "DIARY";
  GRANT CREATE SYNONYM TO "DIARY";
  GRANT CREATE VIEW TO "DIARY";
  GRANT CREATE SEQUENCE TO "DIARY";
  GRANT CREATE PROCEDURE TO "DIARY";
  GRANT CREATE TRIGGER TO "DIARY";
  GRANT CREATE MATERIALIZED VIEW TO "DIARY";
  GRANT CREATE TYPE TO "DIARY";
  GRANT CREATE OPERATOR TO "DIARY";
  GRANT CREATE INDEXTYPE TO "DIARY";
  GRANT CREATE DIMENSION TO "DIARY";
  GRANT CREATE JOB TO "DIARY";
  GRANT EXECUTE DYNAMIC MLE TO "DIARY";
  GRANT CREATE PROPERTY GRAPH TO "DIARY";
  GRANT CREATE MLE TO "DIARY";


  GRANT EXECUTE ON "SYS"."JAVASCRIPT" TO "DIARY";

